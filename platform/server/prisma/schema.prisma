generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Game {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String     @db.Text
  category    String
  coverImage  String     @db.VarChar(2048)
  status      GameStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  puzzles     Puzzle[]
  assignments GameAssignment[]

  @@index([status, publishedAt])
  @@index([category, status])
}

// Country media is deliberately separate from the card-deck source so an
// owner can improve visuals without changing gameplay data or redeploying.
model CountryAsset {
  id        String   @id @default(cuid())
  country   String   @unique @db.VarChar(120)
  imageUrl  String   @db.VarChar(2048)
  caption   String?  @db.VarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Puzzle {
  id         String     @id @default(cuid())
  gameId     String
  slug       String
  title      String
  imageUrl   String     @db.VarChar(2048)
  pieceCount Int
  difficulty Difficulty
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(false)
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progress   PuzzleProgress[]

  @@unique([gameId, slug])
  @@index([gameId, isActive, sortOrder])
}

model PlayerProfile {
  id          String           @id @default(cuid())
  firebaseUid String           @unique
  displayName String?
  avatarUrl   String?          @db.VarChar(2048)
  role        UserRole         @default(PLAYER)
  isDisabled  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  progress    PuzzleProgress[]
  entitlements AccessEntitlement[]
  paymentOrders PaymentOrder[]
  auditEvents AdminAudit[] @relation("AuditActor")
  ownedSchool School? @relation("SchoolOwner")
  schoolMemberships SchoolMembership[]
  assignmentsSent GameAssignment[] @relation("AssignmentSender")
  assignmentsReceived GameAssignment[] @relation("AssignmentRecipient")
  resourceAssignmentsSent ResourceAssignment[] @relation("ResourceAssignmentSender")
  resourceAssignmentsReceived ResourceAssignment[] @relation("ResourceAssignmentRecipient")
}

model School {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(160)
  ownerId     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       PlayerProfile @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships SchoolMembership[]
  assignments GameAssignment[]
  resourceAssignments ResourceAssignment[]
}

model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  playerId  String
  role      SchoolMemberRole
  createdAt DateTime         @default(now())
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  player    PlayerProfile    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([schoolId, playerId])
  @@index([playerId, role])
}

model GameAssignment {
  id           String        @id @default(cuid())
  gameId       String
  assignedById String
  recipientId  String
  schoolId     String?
  dueAt        DateTime?
  createdAt    DateTime      @default(now())
  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  assignedBy   PlayerProfile @relation("AssignmentSender", fields: [assignedById], references: [id], onDelete: Restrict)
  recipient    PlayerProfile @relation("AssignmentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  school       School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@unique([gameId, recipientId])
  @@index([assignedById, createdAt])
  @@index([recipientId, dueAt])
}

// A learning assignment is separate from a purchase entitlement. It is issued
// only by a licensed school/teacher to a member in the same school, and gives
// that recipient access to one A-54 mode without exposing their payment data.
model ResourceAssignment {
  id           String        @id @default(cuid())
  resource     String        @db.VarChar(191)
  assignedById String
  recipientId  String
  schoolId     String?
  dueAt        DateTime?
  createdAt    DateTime      @default(now())
  assignedBy   PlayerProfile @relation("ResourceAssignmentSender", fields: [assignedById], references: [id], onDelete: Restrict)
  recipient    PlayerProfile @relation("ResourceAssignmentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  school       School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@unique([resource, recipientId])
  @@index([assignedById, createdAt])
  @@index([recipientId, dueAt])
}

// Purchases are deliberately server-owned. A browser redirect is never an
// entitlement: access is granted only after a verified provider callback.
model PaymentOrder {
  id               String        @id @default(cuid())
  playerId         String
  provider          PaymentProvider
  providerOrderId  String?       @unique @db.VarChar(191)
  amountMinor      Int
  currency         String        @db.Char(3)
  status           PaymentStatus @default(PENDING)
  idempotencyKey   String        @unique @db.VarChar(191)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paidAt           DateTime?
  player           PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Restrict)
  events           PaymentEvent[]
  entitlements     AccessEntitlement[]

  @@index([playerId, status, createdAt])
  @@index([provider, status])
}

model PaymentEvent {
  id               String       @id @default(cuid())
  orderId          String
  providerEventId  String       @unique @db.VarChar(191)
  eventType        String       @db.VarChar(120)
  verified         Boolean      @default(false)
  payload          Json
  receivedAt       DateTime     @default(now())
  order            PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, receivedAt])
}

model AccessEntitlement {
  id          String        @id @default(cuid())
  playerId    String
  orderId     String?
  resource    String        @db.VarChar(191)
  status      EntitlementStatus @default(ACTIVE)
  startsAt    DateTime      @default(now())
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  order       PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([playerId, resource])
  @@index([resource, status, expiresAt])
}

// Owner-managed catalogue. A price is never accepted from the browser: a
// future Pesapal order will look up this server-owned offer by its key.
model AccessOffer {
  id          String        @id @default(cuid())
  key         String        @unique @db.VarChar(120)
  title       String        @db.VarChar(140)
  description String?       @db.VarChar(500)
  kind        OfferKind
  resource    String        @db.VarChar(191)
  amountMinor Int
  currency    String        @db.Char(3)
  interval    OfferInterval @default(ONE_TIME)
  isActive    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, kind])
}

model AppSetting {
  key        String   @id @db.VarChar(120)
  value      Json
  updatedAt  DateTime @updatedAt
  updatedBy  String?  @db.VarChar(191)
}

model AdminAudit {
  id          String        @id @default(cuid())
  actorId     String
  action      String        @db.VarChar(120)
  targetType  String        @db.VarChar(80)
  targetId    String?       @db.VarChar(191)
  details     Json?
  createdAt   DateTime      @default(now())
  actor       PlayerProfile @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model PuzzleProgress {
  id             String        @id @default(cuid())
  playerId       String
  puzzleId       String
  state          Json
  completedAt    DateTime?
  elapsedSeconds Int           @default(0)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  player         PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  puzzle         Puzzle        @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([playerId, puzzleId])
  @@index([playerId, updatedAt])
}

enum GameStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  RELAXED
  CURIOUS
  CHALLENGING
  EXPERT
}

enum UserRole {
  PLAYER
  SCHOOL
  TEACHER
  STUDENT
  MODERATOR
  CONTENT_MANAGER
  ADMIN
  OWNER
}

enum SchoolMemberRole {
  TEACHER
  STUDENT
}

enum PaymentProvider {
  PESAPAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OfferKind {
  GAME
  ACCOUNT
}

enum OfferInterval {
  ONE_TIME
  MONTHLY
  YEARLY
}
