generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Game {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String     @db.Text
  category    String
  coverImage  String     @db.VarChar(2048)
  status      GameStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  puzzles     Puzzle[]
  assignments GameAssignment[]

  @@index([status, publishedAt])
  @@index([category, status])
}

// Country media is deliberately separate from the card-deck source so an
// owner can improve visuals without changing gameplay data or redeploying.
model CountryAsset {
  id        String   @id @default(cuid())
  country   String   @unique @db.VarChar(120)
  imageUrl  String   @db.VarChar(2048)
  caption   String?  @db.VarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Puzzle {
  id         String     @id @default(cuid())
  gameId     String
  slug       String
  title      String
  imageUrl   String     @db.VarChar(2048)
  pieceCount Int
  difficulty Difficulty
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(false)
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progress   PuzzleProgress[]

  @@unique([gameId, slug])
  @@index([gameId, isActive, sortOrder])
}

model PlayerProfile {
  id          String           @id @default(cuid())
  firebaseUid String           @unique
  displayName String?
  avatarUrl   String?          @db.VarChar(2048)
  role        UserRole         @default(PLAYER)
  isDisabled  Boolean          @default(false)
  // Igiti Play supports one actively signed-in device per account. The API
  // compares this browser identifier with the Firebase sign-in time.
  activeDeviceId String?       @db.VarChar(80)
  activeAuthTime Int?
  activeDeviceAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  progress    PuzzleProgress[]
  entitlements AccessEntitlement[]
  paymentOrders PaymentOrder[]
  auditEvents AdminAudit[] @relation("AuditActor")
  ownedSchool School? @relation("SchoolOwner")
  schoolMemberships SchoolMembership[]
  assignmentsSent GameAssignment[] @relation("AssignmentSender")
  assignmentsReceived GameAssignment[] @relation("AssignmentRecipient")
  resourceAssignmentsSent ResourceAssignment[] @relation("ResourceAssignmentSender")
  resourceAssignmentsReceived ResourceAssignment[] @relation("ResourceAssignmentRecipient")
  hostedMatches MultiplayerMatch[] @relation("MatchHost")
  matchParticipants MultiplayerParticipant[]
  matchAnswers MultiplayerAnswer[]
}

model School {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(160)
  ownerId     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       PlayerProfile @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships SchoolMembership[]
  invites     SchoolInvite[]
  assignments GameAssignment[]
  resourceAssignments ResourceAssignment[]
}

// A school invitation never contains a password. It is bound to one email and
// role, and becomes an approved membership only after the recipient signs up.
model SchoolInvite {
  id          String           @id @default(cuid())
  schoolId    String
  email       String           @db.VarChar(254)
  firstName   String           @db.VarChar(80)
  lastName    String           @db.VarChar(80)
  role        SchoolMemberRole
  token       String           @unique @db.VarChar(80)
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedById String?         @db.VarChar(191)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, email])
  @@index([token, expiresAt])
}

model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  playerId  String
  role      SchoolMemberRole
  // Members choose their school, then remain pending until the school owner
  // approves them. Existing memberships are migrated as approved.
  approvedAt DateTime?
  createdAt DateTime         @default(now())
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  player    PlayerProfile    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([schoolId, playerId])
  @@index([playerId, role])
}

model GameAssignment {
  id           String        @id @default(cuid())
  gameId       String
  assignedById String
  recipientId  String
  schoolId     String?
  dueAt        DateTime?
  createdAt    DateTime      @default(now())
  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  assignedBy   PlayerProfile @relation("AssignmentSender", fields: [assignedById], references: [id], onDelete: Restrict)
  recipient    PlayerProfile @relation("AssignmentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  school       School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@unique([gameId, recipientId])
  @@index([assignedById, createdAt])
  @@index([recipientId, dueAt])
}

model ResourceAssignment {
  id           String        @id @default(cuid())
  resource     String        @db.VarChar(191)
  assignedById String
  recipientId  String
  schoolId     String?
  dueAt        DateTime?
  createdAt    DateTime      @default(now())
  assignedBy   PlayerProfile @relation("ResourceAssignmentSender", fields: [assignedById], references: [id], onDelete: Restrict)
  recipient    PlayerProfile @relation("ResourceAssignmentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  school       School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@unique([resource, recipientId])
  @@index([assignedById, createdAt])
  @@index([recipientId, dueAt])
}

// Multiplayer rooms are short-lived, server-owned quiz sessions. Scores are
// updated only after the API validates a submitted answer for the live round.
model MultiplayerMatch {
  id          String                 @id @default(cuid())
  code        String                 @unique @db.VarChar(12)
  resource    String                 @db.VarChar(191)
  mode        String                 @db.VarChar(80)
  hostId      String
  maxPlayers  Int                    @default(4)
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  host        PlayerProfile          @relation("MatchHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants MultiplayerParticipant[]
  answers     MultiplayerAnswer[]

  @@index([expiresAt])
}

model MultiplayerParticipant {
  id        String            @id @default(cuid())
  matchId   String
  playerId  String
  score     Int               @default(0)
  correct   Int               @default(0)
  joinedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  match     MultiplayerMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    PlayerProfile     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([matchId, score])
}

model MultiplayerAnswer {
  id        String            @id @default(cuid())
  matchId   String
  playerId  String
  round     Int
  isCorrect Boolean
  createdAt DateTime          @default(now())
  match     MultiplayerMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    PlayerProfile     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId, round])
  @@index([matchId, round])
}

// Purchases are deliberately server-owned. A browser redirect is never an
// entitlement: access is granted only after a verified provider callback.
model PaymentOrder {
  id               String        @id @default(cuid())
  playerId         String
  provider          PaymentProvider
  providerOrderId  String?       @unique @db.VarChar(191)
  amountMinor      Int
  currency         String        @db.Char(3)
  status           PaymentStatus @default(PENDING)
  idempotencyKey   String        @unique @db.VarChar(191)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paidAt           DateTime?
  player           PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Restrict)
  events           PaymentEvent[]
  entitlements     AccessEntitlement[]

  @@index([playerId, status, createdAt])
  @@index([provider, status])
}

model PaymentEvent {
  id               String       @id @default(cuid())
  orderId          String
  providerEventId  String       @unique @db.VarChar(191)
  eventType        String       @db.VarChar(120)
  verified         Boolean      @default(false)
  payload          Json
  receivedAt       DateTime     @default(now())
  order            PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, receivedAt])
}

model AccessEntitlement {
  id          String        @id @default(cuid())
  playerId    String
  orderId     String?
  resource    String        @db.VarChar(191)
  status      EntitlementStatus @default(ACTIVE)
  startsAt    DateTime      @default(now())
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  order       PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([playerId, resource])
  @@index([resource, status, expiresAt])
}

// Owner-managed catalogue. A price is never accepted from the browser: a
// future Pesapal order will look up this server-owned offer by its key.
model AccessOffer {
  id          String        @id @default(cuid())
  key         String        @unique @db.VarChar(120)
  title       String        @db.VarChar(140)
  description String?       @db.VarChar(500)
  kind        OfferKind
  resource    String        @db.VarChar(191)
  amountMinor Int
  currency    String        @db.Char(3)
  interval    OfferInterval @default(ONE_TIME)
  // School plans use this as their active teacher/student seat cap. Null is
  // intentionally unlimited for legacy offers and individual products.
  seatLimit   Int?
  isActive    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, kind])
}

model AppSetting {
  key        String   @id @db.VarChar(120)
  value      Json
  updatedAt  DateTime @updatedAt
  updatedBy  String?  @db.VarChar(191)
}

model AdminAudit {
  id          String        @id @default(cuid())
  actorId     String
  action      String        @db.VarChar(120)
  targetType  String        @db.VarChar(80)
  targetId    String?       @db.VarChar(191)
  details     Json?
  createdAt   DateTime      @default(now())
  actor       PlayerProfile @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model PuzzleProgress {
  id             String        @id @default(cuid())
  playerId       String
  puzzleId       String
  state          Json
  completedAt    DateTime?
  elapsedSeconds Int           @default(0)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  player         PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  puzzle         Puzzle        @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([playerId, puzzleId])
  @@index([playerId, updatedAt])
}

enum GameStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  RELAXED
  CURIOUS
  CHALLENGING
  EXPERT
}

enum UserRole {
  PLAYER
  SCHOOL
  TEACHER
  STUDENT
  MODERATOR
  CONTENT_MANAGER
  ADMIN
  OWNER
}

enum SchoolMemberRole {
  TEACHER
  STUDENT
}

enum PaymentProvider {
  PESAPAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OfferKind {
  GAME
  ACCOUNT
}

enum OfferInterval {
  ONE_TIME
  MONTHLY
  YEARLY
}
