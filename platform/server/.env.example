# Use a dedicated game-platform database. Never point this at the live store database.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/igiti_play_staging"
PORT=4000
# Comma-separated frontend origins allowed by CORS.
WEB_ORIGIN="https://play.igiti.africa,https://igiti-play-staging-git-feat-nextj-e57261-muhirehuberts-projects.vercel.app"
# Set this Render secret to the full Firebase service-account JSON string. Never commit a real key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated, verified Firebase email addresses authorised for the admin portal.
ADMIN_EMAILS=
