# Use a dedicated game-platform database/schema. Do not point this at the live store database.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/igiti_play"
PORT=4000
WEB_ORIGIN="https://play.igiti.africa"
# Firebase Admin credentials: set GOOGLE_APPLICATION_CREDENTIALS to a private service-account JSON file path,
# or provide the platform's approved workload identity configuration in production.
GOOGLE_APPLICATION_CREDENTIALS=
