# Dedicated Render PostgreSQL database. Never use the store/commerce DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/igiti_play_staging?sslmode=require"
PORT=4000
# Exact comma-separated frontend origins allowed by CORS.
WEB_ORIGIN="https://play.igiti.africa,http://localhost:5173"
# Set this Render secret to the complete Firebase Admin service-account JSON string.
# Do not commit a real service-account key or use it in Vite frontend variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated, verified Firebase email addresses authorised for the game admin API.
ADMIN_EMAILS=
